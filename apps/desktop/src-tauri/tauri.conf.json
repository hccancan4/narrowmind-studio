{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NarrowMind Studio",
  "version": "0.0.0",
  "identifier": "studio.narrowmind.app",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NarrowMind Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Build domain-specific language models without the boilerplate.",
    "longDescription": "Open-source desktop IDE for building Domain-Specific Language Models (DSLMs)."
  }
}
